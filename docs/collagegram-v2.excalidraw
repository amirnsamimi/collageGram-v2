    {
      "id": "Dl3KhSpaNRwVi6stnt3Jq",
      "type": "text",
      "x": 847.4694437546319,
      "y": 2070.8953406874007,
      "width": 364.70583075944626,
      "height": 262.4364380368191,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "fktNeSKQkB8Zrs4SSFITb",
      "index": "b8p",
      "roundness": null,
      "seed": 1046319387,
      "version": 359,
      "versionNonce": 1963795296,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755283601910,
      "link": null,
      "locked": false,
      "text": "\nexport const bodyValidation = (schema: ZodSchema) => {\n    return (req: Request, res: Response, next: NextFunction) => {\n        try {\n            req.body = schema.parse(req.body)\n\n            next()\n        } catch (err) {\n            if (err instanceof ZodError) {\n                res.status(400).json({\n                        error: 'invalid parameters', details: err.issues.map((err) => ({\n                                field: err.path.join('.'),\n                                message: err.message\n\n                            })\n                        )\n                    }\n                )\n            }\n        }\n    }\n}\n",
      "fontSize": 9.128223931715443,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nexport const bodyValidation = (schema: ZodSchema) => {\n    return (req: Request, res: Response, next: NextFunction) => {\n        try {\n            req.body = schema.parse(req.body)\n\n            next()\n        } catch (err) {\n            if (err instanceof ZodError) {\n                res.status(400).json({\n                        error: 'invalid parameters', details: err.issues.map((err) => ({\n                                field: err.path.join('.'),\n                                message: err.message\n\n                            })\n                        )\n                    }\n                )\n            }\n        }\n    }\n}\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
