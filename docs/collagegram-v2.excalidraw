      "boundElements": [],
      "updated": 1755283601910,
      "link": null,
      "locked": false,
      "text": "1. add APP_STAGE and check if its !undefined - if its not assign dev to it \n2. create isStage checkers and loadEnv('file name')\n3. create Schema with zod and infer type\n4. parse envSchema with zod and check files\n5. transfer data to schema and hanlde errors \n6. export NODE_EVN and env\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. add APP_STAGE and check if its !undefined - if its not assign dev to it \n2. create isStage checkers and loadEnv('file name')\n3. create Schema with zod and infer type\n4. parse envSchema with zod and check files\n5. transfer data to schema and hanlde errors \n6. export NODE_EVN and env\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
